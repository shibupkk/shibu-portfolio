---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Shibu S — enterprise architecture, technology transformation, and engineering delivery."
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6f7" />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="container navigation" aria-label="Main navigation">
        <a href={`${base}#bio`}>Bio</a>
        <a href={`${base}#portfolio`}>Portfolio</a>
        <a href={`${base}#expertise`}>Expertise</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="container site-footer">
      <p>© {new Date().getFullYear()} Shibu S</p>

      <a href="https://www.linkedin.com/in/shibusubhakaran/">
        LinkedIn
      </a>
    </footer>
  </body>
</html>